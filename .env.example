# Copie para .env e ajuste.
POSTGRES_PASSWORD=astra
# Chave gratuita em https://api.nasa.gov (DEMO_KEY funciona, mas com limite de pedidos por hora)
NASA_API_KEY=DEMO_KEY
# IA de bordo opcional: com "docker compose --profile ia up", use OLLAMA_URL=http://ollama:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
SPACE_WEATHER_REFRESH_MIN=30
